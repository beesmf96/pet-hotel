{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --write resources/js",
        "e2e": "docker rm -f pet_hotel_e2e >/dev/null 2>&1; vite build && playwright test",
        "design:capture": "docker rm -f pet_hotel_e2e >/dev/null 2>&1; vite build && playwright test --config playwright.design.config.js"
    },
    "devDependencies": {
        "@playwright/test": "1.64.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/leaflet": "^1.9.22",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^4.1.12",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^9.2.5",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "@fontsource-variable/bricolage-grotesque": "5.3.0",
        "@inertiajs/vue3": "^3.10.0",
        "leaflet": "^1.9.4",
        "vue": "^3.5.44"
    },
    "overrides": {
        "nanoid": "^3.3.17"
    }
}
