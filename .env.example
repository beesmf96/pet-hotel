# Docker: set to your host user's UID/GID so containers write files as you, not root.
# Run: id -u && id -g
UID=1000
GID=1000

APP_NAME="Pet Hotel"
# Production MUST set APP_ENV=production and APP_DEBUG=false. With debug on, any
# unhandled exception renders a stack trace containing env vars and DB credentials
# to whoever triggered it.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Docker: http://web.pet-hotel.local  |  Local (php artisan serve): http://localhost:8000
APP_URL=http://web.pet-hotel.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# PostgreSQL (Docker) — uncomment and set DB_CONNECTION=pgsql:
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=pet_hotel
# DB_USERNAME=pet_hotel
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Leave unset locally (plain HTTP). MUST be true in production: config/session.php
# reads this with no default, so an unset value ships the session cookie without
# the Secure flag, allowing it to leak over a downgraded connection.
# SESSION_SECURE_COOKIE=true

# Content Security Policy: 'report' (default) | 'enforce' | 'off'.
# 'report' has browsers report violations without blocking anything, so it is
# safe to run against real traffic. Watch storage/logs for "CSP violation", widen
# config/security.php for whatever legitimate source shows up, and only then set
# this to 'enforce'. See .claude/plans/plan-owasp-hardening.md.
CSP_MODE=report

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Docker: use Mailpit (axllent/mailpit) — catches all outgoing mail at http://mailpit.local
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# Local dev without Docker: log driver writes emails to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@pethotel.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
